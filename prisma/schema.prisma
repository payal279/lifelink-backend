generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String
  createdAt DateTime @default(now())
}

model Donor {
  id         Int      @id @default(autoincrement())
  name       String
  age        Int
  bloodGroup String
  phone      String
  city       String
  createdAt  DateTime @default(now())
}

model BloodRequest {
  id                 Int      @id @default(autoincrement())
  patientName        String
  requiredBloodGroup String
  hospitalName       String
  urgency            String
  createdAt          DateTime @default(now())
}